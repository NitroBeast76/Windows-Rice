{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/ascii.txt",
    "color": {
      "1": "#FF3333",
      "2": "#FF7733",
      "3": "#F29718",
      "4": "#FFB454",
      "5": "#E7C547",
      "6": "#FFEE99",
      "7": "#B8CC52",
      "8": "#95E6CB",
      "9": "#36A3D9"
    },
    "padding": {
      "top": 1,
      "right": 3
    }
  },
  "display": {
    "separator": " "
  },
  "modules": [
    "break",
    {
      "type": "title",
      "color": {
        "user": "#FFB454",
        "at": "#E6E1CF",
        "host": "#36A3D9"
      }
    },
    "break",
    {
      "type": "os",
      "key": "",
      "keyColor": "#36A3D9"
    },
    {
      "type": "cpu",
      "key": "",
      "keyColor": "#FFB454"
    },
    {
      "type": "board",
      "key": "",
      "keyColor": "#FF7733"
    },
    {
      "type": "memory",
      "key": "",
      "keyColor": "#B8CC52",
      "format": "{used} / {total} ({percentage})"
    },
    {
      "type": "disk",
      "key": "",
      "keyColor": "#95E6CB"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}