{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/ascii.txt",
    "color": {
      "1": "#6272A4",
      "2": "#FF5555",
      "3": "#FFB86C",
      "4": "#F1FA8C",
      "5": "#50FA7B",
      "6": "#8BE9FD",
      "7": "#BD93F9",
      "8": "#FF79C6",
      "9": "#F8F8F2"
    },
    "padding": {
      "top": 1,
      "right": 3
    }
  },
  "display": {
    "separator": " "
  },
  "modules": [
    "break",
    {
      "type": "title",
      "color": {
        "user": "#FF79C6",
        "at": "#F8F8F2",
        "host": "#8BE9FD"
      }
    },
    "break",
    {
      "type": "os",
      "key": "",
      "keyColor": "#8BE9FD"
    },
    {
      "type": "cpu",
      "key": "",
      "keyColor": "#FF79C6"
    },
    {
      "type": "board",
      "key": "",
      "keyColor": "#FFB86C"
    },
    {
      "type": "memory",
      "key": "",
      "keyColor": "#50FA7B",
      "format": "{used} / {total} ({percentage})"
    },
    {
      "type": "disk",
      "key": "",
      "keyColor": "#8BE9FD"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}