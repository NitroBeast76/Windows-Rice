{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/ascii.txt",
    "color": {
      "1": "#C34043",
      "2": "#FF9E3B",
      "3": "#DCA561",
      "4": "#76946A",
      "5": "#7AA89F",
      "6": "#7E9CD8",
      "7": "#957FB8",
      "8": "#DCD7BA",
      "9": "#938AA9"
    },
    "padding": {
      "top": 1,
      "right": 3
    }
  },
  "display": {
    "separator": " "
  },
  "modules": [
    "break",
    {
      "type": "title",
      "color": {
        "user": "#DCA561",
        "at": "#DCD7BA",
        "host": "#7E9CD8"
      }
    },
    "break",
    {
      "type": "os",
      "key": "",
      "keyColor": "#7E9CD8"
    },
    {
      "type": "cpu",
      "key": "",
      "keyColor": "#DCA561"
    },
    {
      "type": "board",
      "key": "",
      "keyColor": "#FF9E3B"
    },
    {
      "type": "memory",
      "key": "",
      "keyColor": "#76946A",
      "format": "{used} / {total} ({percentage})"
    },
    {
      "type": "disk",
      "key": "",
      "keyColor": "#7AA89F"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}