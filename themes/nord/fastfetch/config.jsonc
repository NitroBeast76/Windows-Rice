{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/ascii.txt",
    "color": {
      "1": "#ECEFF4",
      "2": "#D08770",
      "3": "#B48EAD",
      "4": "#88C0D0",
      "5": "#8FBCBB",
      "6": "#81A1C1",
      "7": "#5E81AC",
      "8": "#4C566A",
      "9": "#3B4252"
    },
    "padding": {
      "top": 1,
      "right": 3
    }
  },
  "display": {
    "separator": " "
  },
  "modules": [
    "break",
    {
      "type": "title",
      "color": {
        "user": "#D08770",
        "at": "#ECEFF4",
        "host": "#88C0D0"
      }
    },
    "break",
    {
      "type": "os",
      "key": "",
      "keyColor": "#88C0D0"
    },
    {
      "type": "cpu",
      "key": "",
      "keyColor": "#D08770"
    },
    {
      "type": "board",
      "key": "",
      "keyColor": "#EBCB8B"
    },
    {
      "type": "memory",
      "key": "",
      "keyColor": "#A3BE8C",
      "format": "{used} / {total} ({percentage})"
    },
    {
      "type": "disk",
      "key": "",
      "keyColor": "#81A1C1"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}