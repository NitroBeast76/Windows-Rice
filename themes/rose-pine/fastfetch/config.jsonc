{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/ascii.txt",
    "color": {
      "1": "#EB6F92",
      "2": "#F6C177",
      "3": "#EBBCBA",
      "4": "#C4A7E7",
      "5": "#9CCFD8",
      "6": "#31748F",
      "7": "#6E6A86",
      "8": "#908CAA",
      "9": "#E0DEF4"
    },
    "padding": {
      "top": 1,
      "right": 3
    }
  },
  "display": {
    "separator": " "
  },
  "modules": [
    "break",
    {
      "type": "title",
      "color": {
        "user": "#C4A7E7",
        "at": "#E0DEF4",
        "host": "#9CCFD8"
      }
    },
    "break",
    {
      "type": "os",
      "key": "",
      "keyColor": "#9CCFD8"
    },
    {
      "type": "cpu",
      "key": "",
      "keyColor": "#C4A7E7"
    },
    {
      "type": "board",
      "key": "",
      "keyColor": "#F6C177"
    },
    {
      "type": "memory",
      "key": "",
      "keyColor": "#31748F",
      "format": "{used} / {total} ({percentage})"
    },
    {
      "type": "disk",
      "key": "",
      "keyColor": "#EBBCBA"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}