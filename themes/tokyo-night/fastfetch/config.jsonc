{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/ascii.txt",
    "color": {
      "1": "#7AA2F7",
      "2": "#F7768E",
      "3": "#FF9E64",
      "4": "#E0AF68",
      "5": "#9ECE6A",
      "6": "#7DCFFF",
      "7": "#7AA2F7",
      "8": "#BB9AF7",
      "9": "#C0CAF5"
    },
    "padding": {
      "top": 1,
      "right": 3
    }
  },
  "display": {
    "separator": " "
  },
  "modules": [
    "break",
    {
      "type": "title",
      "color": {
        "user": "#BB9AF7",
        "at": "#C0CAF5",
        "host": "#7DCFFF"
      }
    },
    "break",
    {
      "type": "os",
      "key": "",
      "keyColor": "#7DCFFF"
    },
    {
      "type": "cpu",
      "key": "",
      "keyColor": "#BB9AF7"
    },
    {
      "type": "board",
      "key": "",
      "keyColor": "#FF9E64"
    },
    {
      "type": "memory",
      "key": "",
      "keyColor": "#9ECE6A",
      "format": "{used} / {total} ({percentage})"
    },
    {
      "type": "disk",
      "key": "",
      "keyColor": "#7DCFFF"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}